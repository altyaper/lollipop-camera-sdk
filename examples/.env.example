# Obtain these values from your own authorized Lollipop client configuration.
# Never commit real values.
LOLLIPOP_APPLICATION_ID=replace-with-your-application-id
LOLLIPOP_REST_API_KEY=replace-with-your-rest-api-key

# Optional. Leave these unset to receive local interactive prompts.
# LOLLIPOP_USERNAME=
# LOLLIPOP_PASSWORD=
